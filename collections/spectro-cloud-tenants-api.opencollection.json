        {
          "info": {
            "name": "Registers a marketplace user by resolving the registration token, verifying entitlements, and provisioning a tenant",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://edge-host-ip:5080/v1/tenants/marketplace/register"
          },
          "docs": "Called after a user completes a SaaS contract purchase on a marketplace (e.g., AWS Marketplace) and is redirected to the Palette registration landing page. The flow resolves the temporary registration token to obtain the user's account identifier and product code, fetches the user's entitlements and creates a new tenant with the corresponding plan and admin user. The registration token is short-lived and must be resolved promptly.\n"
        },
